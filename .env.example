# ================================================
# HjemTrygg – Miljøvariabler
# Kopier denne filen til .env.local og fyll inn
# ================================================

# App
NEXTAUTH_URL=https://hjemtrygg.no
NEXTAUTH_SECRET=

# Database
# Supabase: bruk Transaction mode pooler-URL (port 6543) for DATABASE_URL
# og Direct connection-URL (port 5432) for DIRECT_URL
DATABASE_URL=
DIRECT_URL=

# E-post (Resend)
RESEND_API_KEY=

# Google OAuth (valgfritt)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIS=
STRIPE_PRICE_ID_PLUSS=
STRIPE_PRICE_ID_PREMIUM=

# OpenAI
OPENAI_API_KEY=

# Admin
ADMIN_EMAILS=
