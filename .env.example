# ================================================
# HjemTrygg – Miljøvariabler
# Kopier denne filen til .env.local og fyll inn
# ================================================

# Database
# Bruk Supabase (supabase.com) eller Neon (neon.tech) for PostgreSQL
DATABASE_URL="postgresql://bruker:passord@host:5432/hjemtrygg"

# NextAuth
# Generer med: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generer-med-openssl-rand-base64-32"

# E-post – for magic link innlogging
# Bruk Resend (resend.com), Mailgun, eller SMTP-server
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="din-resend-api-nokkel"
EMAIL_FROM="HjemTrygg <noreply@hjemtrygg.no>"

# Google OAuth (valgfritt – slettes av NextAuth hvis ikke satt)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe – betalinger
# Opprett produkter i Stripe Dashboard og kopier Price IDs
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASIS="price_basis..."
STRIPE_PRICE_PLUSS="price_pluss..."
STRIPE_PRICE_PREMIUM="price_premium..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# OpenAI – TryggBot AI-assistent
# Hent fra platform.openai.com
OPENAI_API_KEY="sk-..."

# Admin
# Kommaseparert liste over e-poster med admin-tilgang
ADMIN_EMAILS="admin@hjemtrygg.no"

# Kontakt-e-post
CONTACT_EMAIL="hei@hjemtrygg.no"

# Storage – for dokumentopplasting (valgfritt)
# Sett opp Supabase Storage eller AWS S3 for faktisk fillagring
STORAGE_PROVIDER="supabase"
STORAGE_BUCKET="hjemtrygg-dokumenter"
STORAGE_URL="https://ditt-prosjekt.supabase.co/storage/v1"
